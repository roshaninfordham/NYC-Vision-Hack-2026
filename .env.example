# Roboflow private API key (server-side only — never shipped to the browser)
ROBOFLOW_API_KEY=

# Roboflow model to use for detection, e.g. "coco/25"
ROBOFLOW_MODEL=

# Gemini: on Cloud Run we use Vertex AI with the service identity (no key needed).
# For local dev, paste an AI Studio key here.
GEMINI_API_KEY=

# Optional hard cap on Roboflow inference calls per server lifetime (credit guard)
MAX_INFERENCE_CALLS=500

PORT=8080
